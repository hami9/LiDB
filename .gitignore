.idea/
.vscode/*
!.vscode/extensions.json
*.swp
*.swo
.DS_Store
Thumbs.db
*.tmp
__pycache__/
*.py[cod]

# Keep Cargo.lock when the application workspace is introduced.

# Local Git worktrees (NEVER track per-agent checkout data)
/.worktrees/
/.worktree/

# Python cache
__pycache__/
*.py[cod]

