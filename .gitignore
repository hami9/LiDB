# Rust and native build output
/target/
/build/
/dist/
**/CMakeFiles/
**/CMakeCache.txt
**/compile_commands.json
*.o
*.so
*.a

# Local environment, secrets and diagnostics
.env
.env.*
!.env.example
*.key
*.pem
*.p12
*.pcap
*.pcapng
*.core
*.dmp
/var/
/local-data/
/support-bundles/

